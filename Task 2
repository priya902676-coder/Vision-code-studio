print("Even Numbers Divisible by 2 but Not by 4 between 1 to n")

n = int(input("Enter a value of n: "))
count = 0
sum = 0

for i in range(1, n + 1):
    if i % 2 == 0:
        if i % 4 != 0:
            count += 1
            sum += i
            print(i)

print("Count =", count)
print("Sum =", sum)
